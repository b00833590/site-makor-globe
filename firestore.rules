rules_version = '2';

// Deployed manually via the Firebase console (project makor-morning-news →
// Firestore Database → Rules). Not wired to any CLI/CI — this file is the
// source of truth on disk, keep it in sync when you edit the console.
//
// Portfolio rows (mkg:portfolio:*) carry a monotonic `gen` counter. A write is
// only accepted when its `gen` is exactly current+1. A browser left open on an
// old build of index.html cannot produce that:
//   - its .set() sends no `gen`            -> gen stays 0, 0 != current+1  -> denied
//   - an older .update() inherits `gen`    -> unchanged, current != current+1 -> denied
// so a stale tab can no longer resurrect a deleted row or overwrite an edit
// made elsewhere, however long it stays open. See index.html nextPortfolioGen().
//
// One-off admin fixes run from a script play by the same rule: read the doc,
// write gen = current + 1. (No `adm`-style bypass field — once written onto a
// doc it would permanently whitelist every future write to that doc.)

service cloud.firestore {
  match /databases/{database}/documents {

    match /mkg_pdfchunks/{doc} {
      allow read, write: if true;
    }

    match /mkg_data/{doc} {
      allow read:   if true;
      allow delete: if true;
      allow create, update: if !doc.matches('mkg:portfolio:.*')
        || request.resource.data.get('gen', 0)
             == (resource == null ? 0 : resource.data.get('gen', 0)) + 1;
    }
  }
}
